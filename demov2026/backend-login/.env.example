# Copia este archivo como ".env" y ajusta los valores

PORT=3000

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=login_db
DB_USER=postgres
DB_PASSWORD=postgres
# Poner en true al usar Amazon RDS (exige conexión SSL)
DB_SSL=false

# Llave secreta para firmar el token JWT (cámbiala por una propia)
JWT_SECRET=cambia_esta_llave_por_una_segura
JWT_EXPIRES_IN=1h
